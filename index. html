<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SK EARN</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;background:#080d1a;color:white;
 font-family:Arial,sans-serif
}
header{
 background:#111c32;padding:20px;text-align:center;
 border-bottom:2px solid #00e5a0
}
header h1{color:#00e5a0;margin:0;font-size:30px}
header p{color:#b8c5d8;margin-bottom:0}
main{max-width:480px;margin:auto;padding:16px}
.card{
 background:#121d33;border:1px solid #263653;
 border-radius:16px;padding:20px;margin-bottom:16px
}
h2{font-size:19px;margin-top:0}
.muted{color:#aebbd0;font-size:14px;line-height:1.6}
.balance{text-align:center}
.coins{font-size:44px;color:#00e5a0;font-weight:bold}
.money{font-size:23px;color:#ffd166}
button{
 width:100%;padding:13px;margin-top:10px;
 background:#00e5a0;color:#06180f;border:0;
 border-radius:9px;font-size:16px;font-weight:bold
}
button.secondary{background:#263653;color:white}
input{
 width:100%;padding:13px;margin:8px 0;
 border-radius:8px;border:1px solid #344563;
 background:#080d1a;color:white;font-size:16px
}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.stat{
 background:#1b2942;padding:16px;border-radius:12px;
 text-align:center
}
.stat strong{display:block;color:#00e5a0;font-size:22px}
nav{
 position:sticky;bottom:0;background:#111c32;
 display:grid;grid-template-columns:repeat(4,1fr);
 padding:8px 0
}
nav button{background:transparent;color:white;margin:0;padding:10px 2px;font-size:12px}
.page{display:none}
.page.active{display:block}
.notice{color:#ffd166;font-size:13px;line-height:1.5}
footer{text-align:center;color:#8290a8;padding:20px;font-size:12px}
</style>
</head>

<body>

<header>
 <h1>⚡ SK EARN</h1>
 <p>Earn • Rewards • Grow</p>
</header>

<main>

<section id="loginPage" class="card">
 <h2>📱 Welcome to SK EARN</h2>
 <p class="muted">Sign in to access your rewards dashboard.</p>
 <label for="phone">Mobile number</label>
 <input id="phone" type="tel" placeholder="+91XXXXXXXXXX">
 <button onclick="demoLogin()">Continue</button>
 <p id="loginMessage" class="notice"></p>
 <p class="muted">
 Demo login only. Real OTP verification has not been connected.
 </p>
</section>

<section id="home" class="page active">
 <div class="card balance">
  <h2>💰 Your Coin Balance</h2>
  <div class="coins" id="coins">0</div>
  <div class="money">Demo balance: ₹0</div>
  <p class="muted">100 coins = ₹50 (proposed reward rate)</p>
 </div>

 <div class="grid">
  <div class="stat">
   <strong id="totalEarned">0</strong>
   <span class="muted">Coins earned</span>
  </div>
  <div class="stat">
   <strong id="totalAds">0</strong>
   <span class="muted">Demo tasks</span>
  </div>
 </div>

 <div class="card">
  <h2>🎯 Daily Rewards</h2>
  <p class="muted">Rewards will appear here after the real system is connected.</p>
  <button onclick="showPage('tasks')">View Tasks</button>
 </div>

 <div class="card">
  <h2>💸 Withdraw</h2>
  <p class="muted">Withdrawal is not available in this demo.</p>
  <button onclick="showPage('withdraw')">Withdrawal Details</button>
 </div>
</section>

<section id="tasks" class="page">
 <div class="card">
  <h2>🎯 Earn Coins</h2>
  <p class="muted">
   This demo does not show real ads or award withdrawable coins.
  </p>
  <p class="notice">
   Real rewards must follow the chosen advertising provider's policies.
  </p>
 </div>
</section>

<section id="withdraw" class="page">
 <div class="card">
  <h2>🏦 Withdraw Rewards</h2>
  <p class="muted">Demo only — no payment will be sent.</p>
  <p class="muted">Your demo coins: <strong id="withdrawCoins">0</strong></p>
  <label for="upi">UPI ID (demo field)</label>
  <input id="upi" placeholder="example@upi">
  <button onclick="withdrawDemo()">Submit Demo Request</button>
  <p id="withdrawMessage" class="notice"></p>
 </div>
</section>

<section id="profile" class="page">
 <div class="card">
  <h2>👤 My Profile</h2>
  <p id="userPhone" class="muted">Not signed in</p>
  <p class="muted">Account type: Demo</p>
  <button class="secondary" onclick="logout()">Log Out</button>
 </div>
</section>

<section class="card">
 <h2>🔐 About this version</h2>
 <p class="muted">
 This is a front-end demo. It has no real authentication,
 secure coin ledger, advertising integration, admin backend,
 or payment processing. Values shown here are not real money.
 </p>
</section>

</main>

<nav>
 <button onclick="showPage('home')">🏠<br>Home</button>
 <button onclick="showPage('tasks')">🎯<br>Tasks</button>
 <button onclick="showPage('withdraw')">💸<br>Withdraw</button>
 <button onclick="showPage('profile')">👤<br>Profile</button>
</nav>

<footer>© 2026 SK EARN</footer>

<script>
let demoCoins = 0;
let signedIn = false;

function demoLogin(){
 const phone = document.getElementById('phone').value.trim();
 const message = document.getElementById('loginMessage');

 if(!/^\+[1-9]\d{7,14}$/.test(phone)){
  message.textContent='Enter a number in international format, e.g. +91XXXXXXXXXX.';
  return;
 }

 signedIn = true;
 document.getElementById('userPhone').textContent=phone;
 document.getElementById('loginPage').style.display='none';
 message.textContent='';

 alert('Demo only: no OTP was sent. Real Firebase authentication is not connected.');
 showPage('home');
}

function showPage(id){
 if(id!=='home' && !signedIn){
  document.getElementById('loginMessage').textContent='Please use the demo login first.';
  document.getElementById('loginPage').style.display='block';
  return;
 }

 document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
 document.getElementById(id).classList.add('active');
 document.getElementById('withdrawCoins').textContent=demoCoins;
}

function withdrawDemo(){
 document.getElementById('withdrawMessage').textContent=
 'Demo only: no withdrawal request or payment has been processed.';
}

function logout(){
 signedIn=false;
 document.getElementById('loginPage').style.display='block';
 document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
 document.getElementById('phone').value='';
 document.getElementById('loginMessage').textContent='';
}
</script>

</body>
</html>
